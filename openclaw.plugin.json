{
  "id": "openclaw-gh-sync",
  "name": "OpenClaw GitHub Sync",
  "description": "Real-time GitHub sync plus scheduled official-backup archive upload for OpenClaw",
  "activation": {
    "onStartup": true
  },
  "configSchema": {
    "type": "object",
    "properties": {
      "repo": {
        "type": "string",
        "description": "GitHub repo URL (https)"
      },
      "branch": {
        "type": "string",
        "description": "Branch to sync to, e.g. instances/default"
      },
      "instanceName": {
        "type": "string",
        "description": "Instance name, [a-z0-9-] max 40"
      },
      "include": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Paths under state dir to mirror"
      },
      "exclude": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Glob patterns to exclude from sync"
      },
      "pushDebounceMs": {
        "type": "number",
        "minimum": 0,
        "description": "Debounce window for auto-push (ms)"
      },
      "pollIntervalSec": {
        "type": "number",
        "minimum": 5,
        "description": "Poll interval for remote changes (s)"
      },
      "backupIntervalH": {
        "type": "number",
        "minimum": 1,
        "description": "Scheduled backup interval (h)"
      },
      "backupRetain": {
        "type": "number",
        "minimum": 1,
        "description": "Backup archives to retain"
      },
      "gitCryptEnabled": {
        "type": "boolean",
        "description": "Encrypt sensitive paths with git-crypt"
      },
      "syncStrategy": {
        "type": "string",
        "enum": [
          "merge",
          "replace-local"
        ],
        "description": "How to handle first sync: merge (default) or replace-local"
      },
      "gitTimeoutMs": {
        "type": "number",
        "minimum": 5000,
        "description": "Git operation block timeout (ms), default 30000. Raise for slow networks, restore fetch auto-relaxes"
      }
    },
    "additionalProperties": false
  }
}